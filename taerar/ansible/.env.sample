# Copy to .env (Git-ignored) to change the provisioning environment.
# PROD (default): full data copies, e.g. all of ~/Downloads from a backup.
# TEST: minimal copies for trying provisioning, e.g. only the first file.
# An exported HOMELAB_PROVISION_ENV overrides this file.
HOMELAB_PROVISION_ENV=PROD
# HOMELAB_LOCATION: local (default) when on the home network, remote when away from it
# (for example when the home internet is down). remote makes every
# *.localdomain.bnowakowski.pl address, such as the Time Machine share
# smb://nas.localdomain.bnowakowski.pl/time-machine, use *.tailscale.bnowakowski.pl
# instead (needs Tailscale connected). An exported HOMELAB_LOCATION overrides this file.
HOMELAB_LOCATION=local
